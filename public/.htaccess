# =============================================================================
# DGLab PWA - Public Directory Apache Configuration
# =============================================================================
# This file is a fallback for the root .htaccess.
# All requests should ideally be handled by the root .htaccess.
# =============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Stop processing if index.php is already reached
    RewriteRule ^index\.php$ - [L]
    
    # Route all other requests in this directory to index.php
    # (Only if they aren't real files/directories)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?__route__=$1 [QSA,L]
</IfModule>

# Disable directory listing
Options -Indexes

# Protect sensitive files if they exist here
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
